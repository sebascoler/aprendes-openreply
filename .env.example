# Plantilla del .env de producción. NO edites este archivo a mano en el VPS:
# corré `scripts/init-env.sh`, que lo copia a .env y genera los secretos.
# Después completás a mano solo las líneas que quedan en __COMPLETAR__.
#
# El mismo .env lo leen compose (para OPENREPLY_REF, OPENREPLY_DOMAIN y
# POSTGRES_PASSWORD) y los tres contenedores de la app (web, worker, cron).
# Que sea uno solo garantiza lo que más importa: ENCRYPTION_KEY idéntica en
# web y worker. Si difieren, el worker no puede descifrar el token de
# Instagram y ningún DM sale.

# ===== Infra (solo los usa compose) =====
# Commit de https://github.com/diwenne/openreply del que se construye la imagen.
OPENREPLY_REF=f37233fb5f531208582a8a99eee8c109c06b108b
OPENREPLY_DOMAIN=reply.aprendes.ai
POSTGRES_PASSWORD=__GENERAR__

# ===== App =====
NEXTAUTH_URL=https://reply.aprendes.ai
NEXTAUTH_SECRET=__GENERAR__
CRON_SECRET=__GENERAR__
# 64 caracteres hex exactos. Cifra los tokens de Instagram en la base.
# Si se pierde o cambia, hay que reconectar todas las cuentas.
ENCRYPTION_KEY=__GENERAR_HEX__

# ===== Base de datos y cola (hostnames internos de compose) =====
DATABASE_URL=postgresql://openreply:__POSTGRES_PASSWORD__@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# ===== Login por magic link (Resend, dominio envios.aprendes.ai) =====
RESEND_API_KEY=__COMPLETAR__
EMAIL_FROM=Aprendes.ai <sebas@envios.aprendes.ai>
# Solo estos emails pueden entrar. Sin esta línea, cualquiera que llegue a la
# URL pública se crea un workspace. Separados por coma.
ALLOWED_EMAILS=sebas@aprendes.ai

# ===== Meta / Instagram (ver docs/meta-app.md) =====
META_GRAPH_API_VERSION=v25.0
# App ID y App Secret del producto "Instagram" (no el App ID de Facebook).
INSTAGRAM_APP_ID=__COMPLETAR__
INSTAGRAM_APP_SECRET=__COMPLETAR__
# Configuración de la app > Básica > Clave secreta de la app.
FACEBOOK_APP_SECRET=__COMPLETAR__
# Este mismo valor se pega en Meta al configurar el webhook.
WEBHOOK_VERIFY_TOKEN=__GENERAR__

# ===== Polling de comentarios perdidos (los defaults van bien) =====
# COMMENT_POLL_INTERVAL_MS=300000
# COMMENT_POLL_MAX_PER_SWEEP=30
# COMMENT_POLL_LOOKBACK_HOURS=72
